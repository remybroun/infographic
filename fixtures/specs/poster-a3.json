    {
      "type": "section",
      "number": "01",
      "title": "The nine steps of a booking, in order",
      "lede": "Nine steps, three of which involve a human waiting for another human."
    },
    {
      "type": "process",
      "span": 12,
      "orientation": "horizontal",
      "steps": [
        {
          "title": "Search",
          "text": "Dates, city, budget."
        },
        {
          "title": "Shortlist",
          "text": "Three to five listings saved."
        },
        {
          "title": "Enquire",
          "text": "The first message is sent."
        },
        {
          "title": "Confirm",
          "text": "The operator accepts."
        },
        {
          "title": "Pay",
          "text": "Deposit clears."
        }
      ]
    },
    {
      "type": "timeline",
      "span": 6,
      "title": "Elapsed time between the steps of a typical booking",
      "orientation": "vertical",
      "ordinal": true,
      "events": [
        {
          "date": "Day 0",
          "title": "Enquiry sent",
          "text": "Guest messages three operators at once."
        },
        {
          "date": "Day 0-2",
          "title": "The silent window",
          "text": "Median first reply 19 hours. A third never get one."
        },
        {
          "date": "Day 2",
          "title": "Terms agreed",
          "text": "Dates and price settle in two or three messages."
        },
        {
          "date": "Day 3",
          "title": "Deposit paid",
          "text": "Once paid, cancellation drops below 4%."
        },
        {
          "date": "Day 30+",
          "title": "Check-in",
          "text": "The stay begins, on average 34 days after the search."
        }
      ]
    },
    {
      "type": "cycle",
      "span": 6,
      "title": "The feedback loop between reply time and enquiry volume",
      "center_label": "The reply loop",
      "steps": [
        {
          "title": "Reply is slow"
        },
        {
          "title": "Guest messages more operators"
        },
        {
          "title": "Operators see more enquiries"
        },
        {
          "title": "Each gets less attention"
        }
      ],
      "note": "The last step feeds the first, which is what makes this a cycle rather than a chain."
    },
    {
      "type": "section",
      "number": "02",
      "title": "Which steps lose the most volume",
      "lede": "Two of the five steps account for most of the loss.",
      "break": "before"
