  "fonts_css": "",
  "color_model": "grayscale",
  "waivers": {
    "chroma_floor": {
      "colors": [
        "#1a1a1a",
        "#7d7d7d",
        "#b4b4b4",
        "#4d4d4d",
        "#9a9a9a",
        "#2e2e2e",
        "#666666",
        "#cccccc"
      ],
      "reason": "a grayscale theme has no chroma by definition. Identity cannot ride on hue here, which is exactly why force_texture is on and direct labels are mandatory."
    },
    "lightness_band": {
      "colors": [
        "#1a1a1a",
        "#7d7d7d",
        "#b4b4b4",
        "#4d4d4d",
        "#9a9a9a",
        "#2e2e2e",
        "#666666",
        "#cccccc"
      ],
      "reason": "the band keeps eight HUES separable; a lightness-stepped gray palette must deliberately span wider so its steps stay apart."
    }
  }
